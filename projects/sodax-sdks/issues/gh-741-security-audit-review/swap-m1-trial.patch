@@ -0,0 +1,75 @@
+/**
+ * verifyEvmApprovalPlan must reject every way a hostile backend could bend an approval plan
+ * (SWAP-M-1) while passing exactly what a legitimate backend builds.
+ */
+import { describe, expect, it } from 'vitest';
+import { type Address, encodeFunctionData, erc20Abi, maxUint256 } from 'viem';
+import { verifyEvmApprovalPlan } from './verifyEvmApprovalPlan.js';
+
+const TOKEN = '0x2222222222222222222222222222222222222222' as Address;
+const SPENDER = '0x3333333333333333333333333333333333333333' as Address;
+const ATTACKER = '0x4444444444444444444444444444444444444444' as Address;
+const USER = '0x1111111111111111111111111111111111111111' as Address;
+
+const expected = { token: TOKEN, spender: SPENDER, inputAmount: 1_000n };
+
+const approveTx = (spender: Address, amount: bigint, overrides: object = {}) => ({
+  from: USER,
+  to: TOKEN,
+  value: 0n,
+  data: encodeFunctionData({ abi: erc20Abi, functionName: 'approve', args: [spender, amount] }),
+  ...overrides,
+});
+
+describe('verifyEvmApprovalPlan', () => {
+  it('passes a legitimate exact-amount approve', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 1_000n) }, expected)).not.toThrow();
+  });
+
+  it('passes a max-uint approve and a zeroing resetTx', () => {
+    expect(() =>
+      verifyEvmApprovalPlan({ tx: approveTx(SPENDER, maxUint256), resetTx: approveTx(SPENDER, 0n) }, expected),
+    ).not.toThrow();
+  });
+
+  it('rejects an approve to an attacker spender', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(ATTACKER, 1_000n) }, expected)).toThrow(/spender/);
+  });
+
+  it('rejects a tx targeting a different token contract', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 1_000n, { to: ATTACKER }) }, expected)).toThrow(
+      /input token/,
+    );
+  });
+
+  it('rejects non-approve calldata (e.g. transfer)', () => {
+    const transferTx = approveTx(SPENDER, 1_000n, {
+      data: encodeFunctionData({ abi: erc20Abi, functionName: 'transfer', args: [ATTACKER, 1_000n] }),
+    });
+    expect(() => verifyEvmApprovalPlan({ tx: transferTx }, expected)).toThrow(/instead of approve/);
+  });
+
+  it('rejects unknown calldata', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 1_000n, { data: '0xdeadbeef' }) }, expected)).toThrow(
+      /not a known ERC-20 call/,
+    );
+  });
+
+  it('rejects an approve below the input amount', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 999n) }, expected)).toThrow(/below the input amount/);
+  });
+
+  it('rejects a resetTx that does not zero the allowance', () => {
+    expect(() =>
+      verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 1_000n), resetTx: approveTx(ATTACKER, maxUint256) }, expected),
+    ).toThrow(/resetTx/);
+  });
+
+  it('rejects a tx that attaches native value to the approve', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: approveTx(SPENDER, 1_000n, { value: 5n }) }, expected)).toThrow(/value/);
+  });
+
+  it('rejects a non-EVM-shaped tx', () => {
+    expect(() => verifyEvmApprovalPlan({ tx: { payload: 'xx' } as never }, expected)).toThrow(/not an EVM transaction/);
+  });
+});
