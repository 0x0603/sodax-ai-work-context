new file mode 100644
index 000000000..9531bf21b
--- /dev/null
+++ b/packages/dapp-kit/src/utils/verifyEvmApprovalPlan.ts
@@ -0,0 +1,65 @@
+import type { EvmRawTransaction, RawTxReturnType } from '@sodax/sdk';
+import { type Address, decodeFunctionData, erc20Abi, type Hex, isAddressEqual } from 'viem';
+import type { ApprovalPlan } from './approvalPlan.js';
+
+/** What the user actually asked to approve — the only thing the backend's txs may express. */
+export type ExpectedEvmApproval = {
+  /** ERC-20 the user is paying with — every plan tx must target it. */
+  token: Address;
+  /** The only contract allowed to become the spender (config-derived, same source as SwapService). */
+  spender: Address;
+  /** The approve amount must cover the swap input. */
+  inputAmount: bigint;
+};
+
+/**
+ * Fail-closed semantic check of a backend-built EVM approval plan before anything is signed:
+ * a compromised or mis-pointed Swaps/Bridge API must not be able to have the user's wallet
+ * sign `approve(attacker, …)` or any non-approve calldata (SWAP-M-1).
+ */
+export function verifyEvmApprovalPlan(plan: ApprovalPlan, expected: ExpectedEvmApproval): void {
+  if (plan.resetTx !== undefined) verifyApproveTx(plan.resetTx, expected, 'resetTx', 0n);
+  verifyApproveTx(plan.tx, expected, 'tx', undefined);
+}
+
+function verifyApproveTx(
+  raw: RawTxReturnType,
+  expected: ExpectedEvmApproval,
+  label: 'tx' | 'resetTx',
+  exactAmount: bigint | undefined,
+): void {
+  const tx = raw as Partial<EvmRawTransaction>;
+  if (typeof tx.to !== 'string' || typeof tx.data !== 'string') {
+    throw new Error(`[approvalPlan] backend ${label} is not an EVM transaction`);
+  }
+  if (!isAddressEqual(tx.to as Address, expected.token)) {
+    throw new Error(`[approvalPlan] backend ${label} targets ${tx.to} instead of the input token ${expected.token}`);
+  }
+  if ((tx.value ?? 0n) !== 0n) {
+    throw new Error(`[approvalPlan] backend ${label} attaches value ${tx.value} to an ERC-20 approve`);
+  }
+
+  let decoded: ReturnType<typeof decodeFunctionData<typeof erc20Abi>>;
+  try {
+    decoded = decodeFunctionData({ abi: erc20Abi, data: tx.data as Hex });
+  } catch {
+    throw new Error(`[approvalPlan] backend ${label} calldata is not a known ERC-20 call`);
+  }
+  if (decoded.functionName !== 'approve') {
+    throw new Error(`[approvalPlan] backend ${label} calls ${decoded.functionName} instead of approve`);
+  }
+
+  const [spender, amount] = decoded.args as readonly [Address, bigint];
+  if (!isAddressEqual(spender, expected.spender)) {
+    throw new Error(`[approvalPlan] backend ${label} approves spender ${spender}, expected ${expected.spender}`);
+  }
+  if (exactAmount !== undefined) {
+    if (amount !== exactAmount) {
+      throw new Error(`[approvalPlan] backend ${label} must zero the allowance but approves ${amount}`);
+    }
+  } else if (amount < expected.inputAmount) {
+    throw new Error(
+      `[approvalPlan] backend ${label} approves ${amount}, below the input amount ${expected.inputAmount}`,
+    );
+  }
+}
